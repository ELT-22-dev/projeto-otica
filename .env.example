# Copie para .env.local e preencha. Nunca commite o .env.local.

# --- App (cadastrar também na Vercel) -------------------------------------
# Neon → Connection Details. Use a string "pooled" (host com -pooler).
# Se o banco for criado pela integração Neon da Vercel, ela já preenche isso lá.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Opcional, só para scripts (migrations): string direta, sem -pooler.
DATABASE_URL_UNPOOLED=

# Segredo que assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Só para o seed (NÃO cadastrar na Vercel) -----------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=Eddy

# Opcional: atendente (sem acesso a Ajustes)
SEED_ATENDENTE_EMAIL=
SEED_ATENDENTE_PASSWORD=
SEED_ATENDENTE_NOMBRE=Nataly

# Opcional: seu WhatsApp, usado em 3 clientes da demo para o wa.me abrir uma conversa real
SEED_DEMO_WHATSAPP=

# --- IA (opcional) --------------------------------------------------------
# Leitura de receita por foto, assistente e respostas no WhatsApp. Só liga com IA_ACTIVA=1
# e a chave do provedor escolhido (com créditos). Cadastrar no app e no serviço do WhatsApp.
IA_ACTIVA=0
# claude (padrão) | openai | nvidia
IA_PROVEEDOR=claude
# Opcional. Pode ser uma lista separada por vírgula: se um modelo sair do catálogo, usa o próximo.
# Padrão: claude-opus-5-5 / gpt-5.5 / moonshotai/kimi-k2.6,deepseek-ai/deepseek-v4.1-flash,openai/gpt-oss-20b
IA_MODELO=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# build.nvidia.com → API Keys (começa com nvapi-). Com NVIDIA não há leitura de receita por foto.
NVIDIA_API_KEY=

# --- WhatsApp conectado por QR (opcional) ---------------------------------
# Serviço que fica ligado o tempo todo (npm run whatsapp; ver README). Sem isso, avisos usam wa.me.
# Mesmo valor no app (Vercel) e no serviço. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WHATSAPP_TOKEN=
# Só no app (Vercel): endereço público do serviço, ex. https://otica-whatsapp.up.railway.app
WHATSAPP_URL=
# Só no serviço: porta (a hospedagem costuma definir sozinha) e nível de log do Baileys
# PORT=3200
# WHATSAPP_LOG=warn
