{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node scripts/railway.mjs build"
  },
  "deploy": {
    "startCommand": "node scripts/railway.mjs start",
    "healthcheckPath": "/api/salud",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 10
  }
}
